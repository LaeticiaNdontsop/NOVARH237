# Copie ce fichier en ".env" et remplis tes propres valeurs. Ne jamais committer le ".env" reel.

SECRET_KEY=change-moi-avec-une-cle-secrete-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Chaine de connexion Supabase (Postgres). Trouvable dans Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:TON_MOT_DE_PASSE@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Cle API Gemini (utilisee au Jour 4 pour l'assistant conversationnel)
GEMINI_API_KEY=ta-cle-api-gemini
# Optionnel : force un modele Gemini precis si le defaut du code devient obsolete
# (voir https://ai.google.dev/gemini-api/docs/models)
# GEMINI_MODEL=gemini-3.5-flash-lite
